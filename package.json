  "version": "0.3.0",
  "author": "Soffinal <smari.sofiane@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/watchmanlab/stream.git"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  },
  "exports": {
